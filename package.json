{
  "$schema": "https://raw.githubusercontent.com/SchemaStore/schemastore/master/src/schemas/json/package.json",
  "name": "static-blog-generator-hexo",
  "version": "1.0.0",
  "private": true,
  "description": "www.webmanajemen.com",
  "main": "package-install.js",
  "author": {
    "name": "dimaslanjaka",
    "email": "dimaslanjaka@gmail.com",
    "url": "https://webmanajemen.com"
  },
  "license": "MIT",
  "scripts": {
    "prestart": "yarn run postinstall",
    "start": "yarn workspace wmi run server",
    "clean": "yarn workspace wmi run clean",
    "build": "yarn workspace wmi run build",
    "build-sort": "yarn workspace wmi run build:prepare && yarn workspace wmi run post:copy && yarn workspace wmi run build:site",
    "postbuild": "yarn workspace wmi run postbuild",
    "build:packages": "yarn workspaces foreach --no-private --all run build",
    "postinstall": "yarn build:packages && node link-workspaces.js",
    "init:husky": "node -e \"try { require.resolve('husky'); } catch (e) { process.exit(0); }\" && husky",
    "prepare": "node .npmrc.builder.cjs && npm run init:husky",
    "update:ncu": "npx -y npm-check-updates -u -x \"jsdom,chalk,hexo,deepmerge-ts,husky,react,react-dom,*react*,prettier,eslint-config-prettier,eslint-plugin-prettier,eslint,@typescript-eslint/parser,@typescript-eslint/eslint-plugin,globals,@eslint/js,@eslint/eslintrc\" --root --workspaces",
    "serve": "yarn workspace wmi run serve",
    "server": "yarn workspace wmi run serve",
    "preview": "php -S localhost:4000 -t site/public"
  },
  "engines": {
    "node": ">=14"
  },
  "packageManager": "yarn@4.14.0",
  "workspaces": {
    "packages": [
      "site",
      "site/multisite/chimeraland",
      "site/src-posts",
      "packages/hexo-generator-redirect"
    ]
  },
  "dependencies": {
    "axios": "^1.16.1",
    "fs-extra": "^11.3.5",
    "minimist": "^1.2.8",
    "sbg-utility": "^2.0.11",
    "upath": "^3.0.7",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11",
    "@types/node": "^25.8.0",
    "@typescript-eslint/eslint-plugin": "^8.40.0",
    "@typescript-eslint/parser": "^8.40.0",
    "binary-collections": "^2.0.11",
    "cross-env": "^10.1.0",
    "depcheck": "^1.4.7",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "git-command-helper": "^2.1.1",
    "husky": "^9.1.7",
    "jsonc-parser": "^3.3.1",
    "npm-check-updates": "^22.2.0",
    "prettier": "^3.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3"
  },
  "resolutions": {
    "@types/through2": "https://github.com/dimaslanjaka/nodejs-package-types/raw/through2/release/types-through2.tgz",
