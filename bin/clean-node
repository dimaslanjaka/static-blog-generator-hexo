#!/usr/bin/env bash

(set -o igncr) 2>/dev/null && set -o igncr; # cygwin encoding fix

# absolute path working directory
basecwd=${PWD}
# base script directory
basedir=$(dirname "$0")
# absolute path script directory
SCRIPT_DIR=$(cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" &> /dev/null && pwd)
# get script path
SCRIPT=$(realpath "$0")
SCRIPTPATH=$(dirname "$SCRIPT")

# Detect Cygwin or MinGW
case "$(uname)" in
  *CYGWIN*)
    basedir=$(cygpath -w "$basedir")
    # make cygwin bin as priority
    export PATH="/usr/local/bin:/usr/bin:/bin:/usr/local/sbin:/usr/sbin:/sbin:$PATH"
    ;;
  *MINGW*)
    # make mingw bin as priority
    export PATH="/mingw64/bin:/usr/local/bin:/usr/bin:/bin:/usr/local/sbin:/usr/sbin:/sbin:$PATH"
    ;;
esac

# parse and export .env file (dotenv)
if [ -f ".env" ]; then
  # Export the vars in .env into your shell:
  export $(egrep -v '^#' .env | xargs)
fi

custom_chars="@."
vowels="aeiouAEIOU"
alnum="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
# parse args: default dry-run; use --force to actually delete
FORCE=0
while [ "$#" -gt 0 ]; do
  case "$1" in
    --force) FORCE=1; shift;;
    --help|-h)
      cat <<'USAGE'
Usage: clean-node [--force]
By default runs in dry-run mode. Use --force to actually delete.
USAGE
      exit 0
      ;;
    *) echo "Unknown option: $1"; exit 1;;
  esac
done
if [ "$FORCE" -eq 1 ]; then DRY_RUN=0; else DRY_RUN=1; fi

find . -type d -name 'node_modules' -prune -print0 |
while IFS= read -r -d '' dir; do
  echo "Found: $dir"
  # iterate each character from alnum + vowels + custom_chars
  combined="$alnum$vowels$custom_chars"
  for ((i=0; i<${#combined}; i++)); do
    char="${combined:i:1}"
    for path in "$dir/${char}"*; do
      [ -e "$path" ] || continue
      if [ "$DRY_RUN" -eq 1 ]; then
        echo "Would remove $path"
      else
        echo "Deleting $path"
        rm -rf -- "$path"
      fi
    done
  done
  # delete node_modules directory itself
  if [ "$DRY_RUN" -eq 1 ]; then
    echo "Would remove $dir"
  else
    echo "Deleting $dir"
    rm -rf -- "$dir"
  fi
done

if [ "$DRY_RUN" -eq 1 ]; then
  echo "Would remove package-lock.json files:";
  find . -path '*/node_modules/*' -prune -o -name "package-lock.json" -print
  echo "Would remove yarn.lock files:";
  find . -path '*/node_modules/*' -prune -o -name "yarn.lock" -print
  echo "Would remove .yarn/cache directories:";
  find . -path '*/node_modules/*' -prune -o -path "*/.yarn/cache" -print
else
  find . -path '*/node_modules/*' -prune -o -name "package-lock.json" -exec rm -rf '{}' +;
  find . -path '*/node_modules/*' -prune -o -name "yarn.lock" -exec rm -rf '{}' +;
  find . -path '*/node_modules/*' -prune -o -path "*/.yarn/cache" -exec rm -rf '{}' +;
fi
